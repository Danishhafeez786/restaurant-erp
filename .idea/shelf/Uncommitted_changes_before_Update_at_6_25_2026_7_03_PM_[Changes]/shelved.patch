+                        loadPlans();
+                    }}
+                    className="bg-[#0d4039] text-white rounded-lg"
+                >
+                    Search
+                </button>
+
+            </div>
+
+            {/* Desktop Table */}
+
+            <div className="hidden md:block overflow-x-auto">
+
+                <table className="w-full">
+
+                    <thead>
+
+                        <tr className="border-b text-left">
