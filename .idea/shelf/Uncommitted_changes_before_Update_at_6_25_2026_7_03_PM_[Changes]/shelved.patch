+                        <div className="flex gap-3 mt-4">
+
+
+                            <button className="flex-1 bg-green-500 text-white py-2 rounded-xl"
+                                onClick={() => {
+                                    setModalMode("view");
+                                    setSelectedPlan(plan);
+                                    setShowModal(true);
+                                }}>
+                                View
+                            </button>
+
+                            {plan.isActive && (
+                                        <>
+
+                            <button className="flex-1 bg-blue-500 text-white py-2 rounded-xl"
