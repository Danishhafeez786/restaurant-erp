+                                            setSelectedPlan(plan);
+                                            setShowModal(true);
+                                        }}
+                                        className="text-green-600 mr-3"
+                                    >
+                                        View
+                                    </button>
+
+                                    {plan.isActive && (
+                                        <>
+                                            <button
+                                                onClick={() => {
+                                                    setModalMode("edit");
+                                                    setSelectedPlan(plan);
+                                                    setShowModal(true);
+                                                }}
+                                                className="text-blue-600 mr-3"
+                                            >
+                                                Edit
+                                            </button>
+
+                                            <button
